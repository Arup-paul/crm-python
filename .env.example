# Copy this file to .env and put real values there. Only this example file goes to git.
# Comments stay on their own lines: some .env readers treat "value  # comment" as part of the value.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL: used by the db container AND by Django ---
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=change-me
# The compose service name, not localhost
DB_HOST=db
# The port inside the Docker network (5433 is only for your machine)
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Your user id (`id -u` / `id -g`), so files created in containers belong to you ---
HOST_UID=1000
HOST_GID=1000
